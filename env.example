# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel
MODERATOR_CHAT_ID=your_telegram_id
PORT=10000

# Gemini — новий ключ: лише flash-моделі для текстових постів.
# НЕ додавай pro/image/tts/embedding/live — вони палять квоту або дають 403.
GEMINI_API_KEY=your_gemini_key
# Можна не задавати взагалі: дефолт бере живі flash-моделі за спаданням версії.
# Мертві покоління (2.0, 2.5, 1.5) відсіюються автоматично — вони віддають 404.
# GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# Скільки моделей пробувати за запит. Менше 3 — один 503 губить пост.
# GEMINI_MAX_MODELS_PER_REQUEST=4
# Пауза між Gemini-запитами (сек) і макс. очікування Retry-After:
# GEMINI_MIN_INTERVAL_SEC=6
# GEMINI_MAX_RETRY_WAIT_SEC=180
# Глобальна пауза після вичерпання квоти (сек, Redis):
# GEMINI_GLOBAL_COOLDOWN_SEC=14400
# Скільки Gemini-викликів/день на відео+банкноти (розклад НЕ рахується). Free tier ≈ 2.
# GEMINI_OPTIONAL_MAX_PER_DAY=2
# Повтори рубрики при 429 у розкладі:
# GEMINI_SCHEDULE_RETRIES=2
# GEMINI_SCHEDULE_RETRY_DELAY_SEC=180

# Upstash Redis
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your_redis_token

# YouTube
YOUTUBE_API_KEY=your_youtube_key

# NewsAPI
NEWSAPI_KEY=your_newsapi_key

# Банкноти (#НоваБанкнота) — раз на кілька днів; lookback довгий, щоб не пропустити
# BANKNOTE_LOOKBACK_DAYS=21
# BANKNOTE_POLL_DAYS=7
# BANKNOTE_MAX_PER_DAY=0
# BANKNOTE_MAX_PER_CYCLE=3
# BANKNOTE_USE_SEARCH=0
# BANKNOTE_MIN_SCORE=10

# Відео — 1 сканування Gemini/день; зайві в чергу на наступні дні
# VIDEO_SCHEDULE_TIME=18:27
# VIDEO_QUEUE_MAX=5
# VIDEO_GEMINI_COOLDOWN_HOURS=8
# Тренажер мозку — стиль «Клуб 1%»; тип clever викликає Gemini
# BRAIN_SCHEDULE_TIME=21:07
# BRAIN_START_LEVEL=2
# Складність 1–5 → бейдж «лише 90%…5%»
# Пороги точності каналу, за якими складність росте / падає
# BRAIN_LEVEL_UP_ACCURACY=75
# BRAIN_LEVEL_DOWN_ACCURACY=40
# Менше голосів — складність не рухаємо
# BRAIN_MIN_VOTES_FOR_ADAPT=5
# Скільки днів пам'ятаємо задачу, щоб не повторити
# BRAIN_SEEN_TTL_DAYS=120

# Країни (#ВгадайКраїну / #КраїнаВДеталях) — Wikidata + FlagCDN, без ключів
# Кеш довідника: SPARQL-запит триває десятки секунд, тримаємо тижнями
# COUNTRY_CACHE_TTL_DAYS=14
# Скільки днів не повторювати країну (окремо на кожен режим)
# COUNTRY_SEEN_TTL_DAYS=180
# Відсікаємо мікродержави
# COUNTRY_MIN_POPULATION=300000
# Варіантів у опитуванні і як часто вони з того самого континенту (складніше)
# COUNTRY_POLL_OPTIONS=4
# COUNTRY_SAME_CONTINENT_ODDS=0.7

# Чим закрити слот, якщо рубрика не знайшла матеріалу (має бути безкоштовною).
# Порожньо = слот просто пропускається.
# RUBRIC_FALLBACK=

# Пошук YouTube: relevance/date/viewCount (date давав найновіше, а не найкраще)
# YOUTUBE_SEARCH_ORDER=relevance
# Вікно тривалості в секундах: відсікає Shorts і багатогодинні стріми
# VIDEO_MIN_DURATION_SEC=90
# VIDEO_MAX_DURATION_SEC=1500

# Stock photos
PEXELS_API_KEY=your_pexels_api_key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
STOCK_PHOTO_PROVIDER=auto
# STOCK_PHOTO_CANDIDATES=8
# STOCK_PHOTO_DEDUP_DAYS=14
